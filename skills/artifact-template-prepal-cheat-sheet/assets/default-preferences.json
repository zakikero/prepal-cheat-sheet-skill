    "abbreviations": "define-unfamiliar",
    "fill_available_space": true,
    "include_diagrams": "ask"
  },
  "delivery": {
    "formats": [
      "docx",
      "pdf"
    ],
    "coverage_companion": true,
    "print_scale_percent": 100
